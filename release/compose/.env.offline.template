# Copy to .env next to docker-compose.offline.yml on the offline server and
# adjust as needed. Never commit a real .env with production values.

RELEASE_VERSION=1.0.2

# See the port note in docker-compose.offline.yml before changing BACKEND_PORT.
BACKEND_PORT=8001
FRONTEND_PORT=8080

# Where persistent data lives on the offline host. Sub-folders app-storage/,
# root-storage/, and logs/ are created automatically by install_offline.sh.
STORAGE_ROOT=/opt/healthcare-reporting/storage

ENABLE_AI=false
