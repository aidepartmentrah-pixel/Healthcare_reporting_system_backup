# Copy this file to .env and adjust as needed. Never commit the real .env.

# Host port the backend is published on. The frontend's runtime config
# (frontend/public/config.json + frontend/src/config/api.js) falls back to
# calling the page's hostname on port 8001 when no explicit apiBaseUrl is
# set. If you change BACKEND_PORT away from 8001, you must also set an
# explicit apiBaseUrl in frontend/public/config.json and rebuild the
# frontend image, or the frontend won't find the backend.
BACKEND_PORT=8001

# Host port the frontend (nginx) is published on. Freely changeable.
FRONTEND_PORT=8080

# Enables AI-assisted analysis features (requires llama-cpp-python and a
# local model, not installed by default). Leave false unless that's set up.
ENABLE_AI=false
